# Copied to .env for local dev. Vite only exposes variables prefixed with VITE_.

# API base (must include /api — same as Nest global prefix).
Local: /api is proxied to http://localhost:4000 (see vite.config.js).
VITE_API_BASE_URL=/api

# Production build example (set in host UI or .env.production):
# VITE_API_BASE_URL=https://api-ezcrm.redonix.in/api
#
# Optional override for `/uploads/...` URLs only — full prefix including /api
# VITE_UPLOADS_ORIGIN=https://api-ezcrm.redonix.in/api
#
# Hostinger Object Storage (only needed if using S3-compatible bucket for avatars/logos):
# VITE_STORAGE_BUCKET_ENDPOINT=https://<hostinger-object-storage-endpoint>
# VITE_STORAGE_BUCKET_NAME=your-bucket-name
